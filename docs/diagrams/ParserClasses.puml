@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

Class "{abstract}\nCommand" as Command
Class XYZCommand

package "Parser classes" {
    Class "<<interface>>\nParser<T extends Command>" as Parser
    Class AddressBookParser
    Class XYZCommandParser
    Class BalanceCommandParser
    Class SortOrderParser
    Class CliSyntax
    Class ParserUtil
    Class ArgumentMultimap
    Class ArgumentTokenizer
    Class Prefix
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> AddressBookParser : command text

AddressBookParser .down.> XYZCommandParser : <<create>>
AddressBookParser ..> Command : returns

XYZCommandParser ..> XYZCommand : <<create>>
XYZCommandParser .up.|> Parser
XYZCommandParser ..> ArgumentMultimap
XYZCommandParser ..> ArgumentTokenizer
XYZCommandParser ..> CliSyntax
XYZCommandParser ..> ParserUtil
XYZCommandParser ..> BalanceCommandParser
XYZCommandParser ..> SortOrderParser
ArgumentTokenizer .left.> ArgumentMultimap
ArgumentTokenizer ..> Prefix
CliSyntax ..> Prefix
ParserUtil ..> Prefix
XYZCommand -up-|> Command

note right of XYZCommandParser
  XYZ stands for Add, Edit, Delete, Clear, Paid,
  Charge, Find, List, Sort, Archive, Unarchive,
  Export, Import and View.
  PaidCommandParser and ChargeCommandParser share
  BalanceCommandParser; SortCommandParser uses
  SortOrderParser.
end note

note bottom of AddressBookParser
  exit and help take no arguments,
  so AddressBookParser creates
  ExitCommand and HelpCommand directly.
end note
@enduml
