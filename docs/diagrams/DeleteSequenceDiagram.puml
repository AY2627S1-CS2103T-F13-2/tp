@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "c:DeleteCommand" as Confirmation LOGIC_COLOR
participant "p:DeleteCommand" as Pending LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant "s:Storage" as Storage STORAGE_COLOR
end box

note over LogicManager, Pending
  The previous command was "delete 1". Its preview
  stored p, bound to the previewed Person, as pendingDelete.
end note

[-> LogicManager : execute("delete confirm")
activate LogicManager

LogicManager -> LogicManager : take and clear pendingDelete (p)

LogicManager -> AddressBookParser : parseCommand("delete confirm")
activate AddressBookParser

create DeleteCommandParser
AddressBookParser -> DeleteCommandParser : DeleteCommandParser()
activate DeleteCommandParser

DeleteCommandParser --> AddressBookParser
deactivate DeleteCommandParser

AddressBookParser -> DeleteCommandParser : parse(" confirm")
activate DeleteCommandParser

create Confirmation
DeleteCommandParser -> Confirmation : DeleteCommand()
activate Confirmation

Confirmation --> DeleteCommandParser
deactivate Confirmation

DeleteCommandParser --> AddressBookParser : c
deactivate DeleteCommandParser
AddressBookParser --> LogicManager : c
deactivate AddressBookParser

note right of LogicManager
  c is a confirmation, so it is
  replaced by the stored p.
end note

LogicManager -> Model : getAddressBook()
activate Model
Model --> LogicManager : addressBook (copied for rollback)
deactivate Model

LogicManager -> Pending : execute(m)
activate Pending

Pending -> Model : deletePerson(person)
activate Model

Model --> Pending
deactivate Model

create CommandResult
Pending -> CommandResult : CommandResult(feedback)
activate CommandResult

CommandResult --> Pending
deactivate CommandResult

Pending --> LogicManager : r
deactivate Pending

LogicManager -> Storage : saveAddressBook(addressBook)
activate Storage
Storage --> LogicManager
deactivate Storage

[<--LogicManager : r
deactivate LogicManager
@enduml
