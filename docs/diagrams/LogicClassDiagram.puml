@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR
skinparam classAttributeIconSize 0
skinparam classAttributeFontColor #FFFFFF

package Logic as LogicPackage {
class Logic <<interface>> {
    + execute(commandText: String): CommandResult
}
class LogicManager
abstract class Command {
    {abstract} + execute(model: Model): CommandResult
}
class DeleteCommand
class CommandResult {
    - feedbackToUser: String
    - showHelp: boolean
    - exit: boolean
}

package "Parser Classes" {
class AddressBookParser
}
}

package Model {
class Model <<interface>> MODEL_COLOR
}

package Storage {
class Storage <<interface>> STORAGE_COLOR
}

show Logic methods
show Command methods
show CommandResult fields

LogicManager .up.|> Logic
LogicManager -left-> "1" Model : model
LogicManager -right-> "1" Storage : storage
LogicManager -down-> "1" AddressBookParser : addressBookParser
LogicManager ..> Command : executes
AddressBookParser ..> Command : returns
DeleteCommand -up-|> Command
Command ..> Model : uses
Command .right.> CommandResult : returns
DeleteCommand ..> CommandResult : <<create>>

note bottom of DeleteCommand
  Representative concrete command.
  Other examples include AddCommand,
  EditCommand, FindCommand,
  ListCommand and ViewCommand.
end note
@enduml
