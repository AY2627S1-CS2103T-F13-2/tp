<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" minWidth="10" percentWidth="100" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" minWidth="0" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <HBox spacing="0.5" alignment="CENTER_LEFT">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="cell_big_label" />
      </HBox>
      <Label fx:id="phone" styleClass="cell_small_label" text="\$phone" />
      <Label fx:id="address" styleClass="cell_small_label" text="\$address" />
      <Label fx:id="startDate" styleClass="cell_small_label" text="\$startDate" />
      <Label fx:id="outstandingAmount" styleClass="cell_small_label" text="\$outstandingAmount" />
      <Label fx:id="subjects" styleClass="cell_small_label" text="\$subjects" wrapText="true" />
      <Label fx:id="tags" styleClass="cell_small_label" text="\$tags" wrapText="true" />
      <Label fx:id="notes" styleClass="cell_small_label" text="\$notes" wrapText="true" />
    </VBox>
  </GridPane>
</HBox>
